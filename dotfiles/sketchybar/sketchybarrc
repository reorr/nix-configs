#!/usr/bin/env bash

# Layout/style adapted from khaneliman/dotfiles, recolored to Flexoki.

source "$HOME/.config/sketchybar/colors.sh"

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

FONT=".SF NS"
NERD_FONT="Maple Mono NF"
PADDINGS=4

sketchybar --bar \
  position=top \
  height=40 \
  blur_radius=30 \
  color="$BASE" \
  corner_radius=0 \
  margin=0 \
  notch_width=0 \
  padding_left=16 \
  padding_right=12 \
  shadow=off \
  sticky=on \
  topmost=off \
  y_offset=0

sketchybar --default \
  updates=when_shown \
  icon.color="$TEXT" \
  icon.font="$NERD_FONT:Bold:16.0" \
  icon.padding_left="$PADDINGS" \
  icon.padding_right="$PADDINGS" \
  label.color="$TEXT" \
  label.font="$FONT:Bold:13.0" \
  label.padding_left="$PADDINGS" \
  label.padding_right="$PADDINGS" \
  background.corner_radius=8 \
  background.height=28 \
  background.padding_left=2 \
  background.padding_right=2

# --- left: workspaces | window app name -------------------------------------
for i in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "ws.$i" left \
    --set "ws.$i" \
      drawing=off \
      icon.drawing=off \
      label.color="$SUBTEXT" \
      label.padding_left=7 \
      label.padding_right=7 \
      background.drawing=off \
      background.color="$ACCENT" \
      click_script="omniwmctl command switch-workspace $i"
done

sketchybar --add item divider left \
  --set divider \
    icon.drawing=off \
    label="|" \
    label.color="$SURFACE" \
    label.padding_left=2 \
    label.padding_right=6

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.padding_left=6 \
    label.padding_right=6 \
    update_freq=2 \
    script="$PLUGIN_DIR/refresh.sh"

# --- right: battery | wifi | time | date ------------------------------------
# Added right-to-left, so visual order is battery, wifi, time, date.
sketchybar --add item date right \
  --set date \
    icon.drawing=off \
    label.color="$SUBTEXT" \
    label.padding_left=6 \
    label.padding_right=6 \
    update_freq=300 \
    script="$PLUGIN_DIR/date.sh"

sketchybar --add item time right \
  --set time \
    icon.drawing=off \
    label.font="$FONT:Bold:15.0" \
    label.color="$ACCENT" \
    label.padding_left=6 \
    label.padding_right=6 \
    update_freq=30 \
    script="$PLUGIN_DIR/time.sh"

sketchybar --add item div.time right \
  --set div.time \
    icon.drawing=off \
    label="|" \
    label.color="$SURFACE" \
    label.padding_left=2 \
    label.padding_right=6

sketchybar --add item wifi right \
  --set wifi \
    icon=$'\xEF\x87\xAB' \
    icon.color="$ACCENT" \
    label.color="$SUBTEXT" \
    update_freq=10 \
    script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item div.wifi right \
  --set div.wifi \
    icon.drawing=off \
    label="|" \
    label.color="$SURFACE" \
    label.padding_left=2 \
    label.padding_right=6

sketchybar --add item battery right \
  --set battery \
    icon=$'\xEF\x89\x80' \
    icon.color="$ACCENT" \
    label.color="$SUBTEXT" \
    update_freq=60 \
    script="$PLUGIN_DIR/battery.sh"

# Prime all scripts once instead of waiting for their update_freq tick.
"$PLUGIN_DIR/time.sh"
"$PLUGIN_DIR/date.sh"
"$PLUGIN_DIR/battery.sh"
"$PLUGIN_DIR/wifi.sh"
"$PLUGIN_DIR/refresh.sh"

sketchybar --update
